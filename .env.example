# Copie para .env e preencha. O .env não vai para o git.
# Lido pelo docker-compose.yml e pelo backend (spring.config.import).

# Endereço do site em produção (docker-compose.prod.yml; o Nginx usa no server_name)
DOMINIO=biblioteca.imbe.rs.gov.br

# Em produção o docker-compose.prod.yml troca por jdbc:mysql://mysql:3306/biblioteca
DB_URL=jdbc:mysql://localhost:3306/biblioteca
DB_USER=biblioteca
DB_PASSWORD=
# Só o container do MySQL usa
MYSQL_ROOT_PASSWORD=

# Pasta das capas. Relativo à pasta backend/ (de onde roda o spring-boot:run); /dados/ está no .gitignore.
# Em produção o padrão é /dados/capas.
CAPAS_DIR=../dados/capas

# Chave do Google Books. Sem ela a cota anônima (compartilhada) costuma estar esgotada: HTTP 429,
# e o Google fica de fora da busca (as outras fontes continuam).
GOOGLE_BOOKS_API_KEY=

# Assinatura do JWT do sistema: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=

# API de login da Prefeitura (usuários AD). Vazia: só usuários locais entram.
AD_AUTH_URL=
AD_AUTH_TOKEN=

# Primeiro administrador (login "admin"), criado só com o banco sem funcionários. Senha provisória.
ADMIN_INICIAL_SENHA=

# Site público: aparecem no rodapé e na confirmação da reserva (vazios não aparecem)
BIBLIOTECA_ENDERECO=
BIBLIOTECA_HORARIO=
BIBLIOTECA_TELEFONE=
