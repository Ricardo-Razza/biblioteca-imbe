# HTTPS=sim (padrão): o próprio Nginx tem o certificado. ${DOMINIO} vem do ambiente do container.
# Certificado em /etc/nginx/certs/fullchain.pem e privkey.pem (pasta montada pelo compose).

server_tokens off;

upstream api {
    server backend:8080;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    # Renovação do Let's Encrypt (certbot --webroot), se a TI usar
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    set $proto_original https;
    include /etc/nginx/snippets/site.conf;
}
