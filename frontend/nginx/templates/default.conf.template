# Gerado na subida do container: ${DOMINIO} vem do .env (docker-compose.prod.yml).
# Certificado em deploy/certs/fullchain.pem e privkey.pem (montado em /etc/nginx/certs).

server_tokens off;

upstream api {
    server backend:8080;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    # Renovação do Let's Encrypt (certbot --webroot), se a TI usar
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Foto da capa enviada pelo celular (o backend aceita até 10 MB)
    client_max_body_size 12m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/csv;
    gzip_min_length 1024;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://api;
        proxy_set_header Host $host;
        # Substitui (não acrescenta): o limite de tentativas por IP do site não pode ser enganado
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/cabecalhos.conf;
    }

    # Arquivos do build têm hash no nome: podem ficar em cache por um ano
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/cabecalhos.conf;
    }

    # Rotas do Angular (/livro/12, /painel/acervo...) caem no index.html, que nunca fica em cache
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/cabecalhos.conf;
    }
}
